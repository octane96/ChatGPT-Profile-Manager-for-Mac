"guide.settings.title" = "Share or Copy Settings";
"guide.settings.share-heading" = "Share settings\n";
"guide.settings.share-body" = "Open a profile’s … menu and select Share Settings to add multiple profiles to one shared group. AGENTS.md and the selected settings point to common files, so changes from any member are shared. They apply the next time ChatGPT starts.\n\n";
"guide.settings.copy-heading" = "Copy settings\n";
"guide.settings.copy-body" = "Open the destination profile’s … menu and select Copy Settings from Another Profile. This makes a one-time duplicate, so later changes to the source do not affect the destination. Same-named settings are backed up before being replaced.\n\n";
"guide.settings.scope-heading" = "What is not shared\n";
"guide.settings.scope-body" = "Authentication, sessions, logs, SQLite indexes, cookies, and ChatGPT projects or chats are never shared or copied. Rules affect execution permissions and require confirmation when selected. Quit ChatGPT for the affected profiles before changing settings.";
"guide.mechanism.settings-heading" = "Where shared settings are stored\n";
"guide.mechanism.settings-body" = "Shared settings groups and backups are stored in a separate app-managed area outside each profile. Shared AGENTS.md and rules entries reference that area. Authentication, sessions, logs, and ElectronUserData are not included.\n\n";
"guide.mechanism.settings-tree" = "~/Library/Application Support/\n└── ChatGPT Profile Manager/\n    ├── Profiles/\n    ├── Settings/\n    │   ├── SharedSettings/\n    │   └── Backups/\n    └── SettingsRegistry.json";
